GROQ_API_KEY=
# No Free Tier, usar o mesmo GPT-OSS 120B com esforço de raciocínio diferente economiza trocas de modelo.
GROQ_FAST_MODEL=openai/gpt-oss-120b
GROQ_DEEP_MODEL=openai/gpt-oss-120b
GROQ_FREE_TIER_MODE=true
GROQ_DAILY_TOKEN_LIMIT=200000
NIX_REASONING_MODE=auto
NIX_QUOTA_PROTECTION=adaptive
NIX_CONTEXT_TOKEN_BUDGET=3600
NIX_MAX_COMPLETION_TOKENS=2200
NIX_MAX_CONCURRENT_RUNS=1
